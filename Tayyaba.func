void addPatient()
{
    int id;

    if(count >= MAX)
    {
        printf("Storage is full\n");
        return;
    }

    printf("ADD NEW ENTRY \n");

    do {
        printf("Enter Patient ID: ");
        if (scanf("%d", &id) != 1) {
            while (getchar() != '\n');
            id = -1;
        }
    } while (id < 1 || id > 999999);

    if(findPatient(id) != -1)
    {
        printf("ID already registered\n");
        return;
    }

    patients[count].id = id;

    readText("Enter Patient Name: ",
             patients[count].name, sizeof(patients[count].name));

    patients[count].age =
        readInteger("Enter Patient Age: ", 1, 120);

    readText("Enter Gender: ",
             patients[count].gender, sizeof(patients[count].gender));

    readText("Enter Phone Number: ",
             patients[count].phone, sizeof(patients[count].phone));

    readText("Enter Disease: ",
             patients[count].disease, sizeof(patients[count].disease));

    count++;

    saveRecords();

    printf("\nPatient record created\n");
}

void displayPatients()
{
    int i;
printf("\n PATIENT RECORDS\n");
 if(count == 0)
    {
        printf("No patient records available.\n");
        return;
    }

    for(i = 0; i < count; i++)
    {
        struct Patient *p = &patients[i];

        printf("\nPatient %d\n", i + 1);

        printf("ID: %d\n", p->id);
        printf("Name: %s\n", p->name);
        printf("Age: %d\n", p->age);
        printf("Gender: %s\n", p->gender);
        printf("Phone: %s\n", p->phone);
        printf("Disease : %s\n", p->disease);
printf("-------------------\n");
    }
}

void searchPatient()
{
    int id, index;  printf("\n SEARCH PATIENT\n");
id = readInteger("Enter Patient ID: ", 1, 999999);
 index = findPatient(id);

    if(index == -1)
    {
        printf("\nNo matching records\n");
    }
    else
    {
        printf("\nPatient Found!\n");
printf("ID      : %d\n", patients[index].id);
        printf("Name    : %s\n", patients[index].name);
        printf("Age     : %d\n", patients[index].age);
        printf("Gender  : %s\n", patients[index].gender);
        printf("Phone   : %s\n", patients[index].phone);
        printf("Disease : %s\n", patients[index].disease);
    }
}
